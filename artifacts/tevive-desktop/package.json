{
  "name": "@workspace/tevive-desktop",
  "version": "0.0.1",
  "description": "Tevive - Free game platform desktop client",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dist:win": "tsc -p tsconfig.json && electron-builder --win --x64",
    "start": "tsc -p tsconfig.json && electron ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "build": {
    "appId": "io.tevive.app",
    "productName": "Tevive",
    "copyright": "Copyright 2026 Tevive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tevive",
      "license": "../../Eula.txt",
      "artifactName": "tevive_setup_windows.exe"
    }
  }
}
